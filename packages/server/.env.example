# Server Environment Configuration
# Copy to .env for local development

NODE_ENV=development
PORT=3001

# Database (for local development with Docker)
DATABASE_URL=postgresql://user:pass@url:port/dbname

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-min-64-characters-hex-string-here
JWT_REFRESH_SECRET=your-refresh-token-secret-min-64-characters-hex

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-encryption-key-exactly-64-hex-characters-here

# CORS
CORS_ORIGIN=http://localhost:3000

# OAuth - Google (optional)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# OAuth - GitHub (optional)
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
