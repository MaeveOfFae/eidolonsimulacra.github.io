// Prisma schema for Eidolon Character Generator Server
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// User Management
// =============================================================================

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String?  // Nullable for OAuth-only users
  displayName     String?
  avatarUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastLoginAt     DateTime?
  isEmailVerified Boolean  @default(false)
  preferences     Json     @default("{}")

  // Relations
  oauthConnections OAuthConnection[]
  sessions         Session[]
  drafts           Draft[]
  themes           Theme[]
  templates        Template[]
  config           UserConfig?
  blueprints       Blueprint[]
  worlds           World[]
  timelines        Timeline[]
  savedSeeds       SavedSeed[]

  @@map("users")
}

model OAuthConnection {
  id             String   @id @default(uuid())
  userId         String
  provider       String   // 'google', 'github'
  providerUserId String
  createdAt      DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_connections")
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  deviceInfo       Json?
  ipAddress        String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// =============================================================================
// Character Data
// =============================================================================

model Draft {
  id             String   @id @default(uuid())
  userId         String
  reviewId       String   // Client-generated unique ID
  seed           String
  mode           String   @default("Auto") // 'SFW', 'NSFW', 'Platform-Safe', 'Auto'
  model          String?
  characterName  String?
  templateName   String?
  genre          String?
  notes          String?
  favorite       Boolean  @default(false)
  tags           String[]
  offspringType  String?
  assets         Json     @default("{}") // Record<string, string>
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentLineage  DraftLineage[] @relation("ChildDraft")
  childLineage   DraftLineage[] @relation("ParentDraft")

  @@unique([userId, reviewId])
  @@index([userId])
  @@index([characterName])
  @@index([createdAt(sort: Desc)])
  @@map("drafts")
}

model DraftLineage {
  id           String   @id @default(uuid())
  parentDraftId String
  childDraftId  String
  createdAt     DateTime @default(now())

  // Relations
  parentDraft Draft @relation("ParentDraft", fields: [parentDraftId], references: [id], onDelete: Cascade)
  childDraft  Draft @relation("ChildDraft", fields: [childDraftId], references: [id], onDelete: Cascade)

  @@unique([parentDraftId, childDraftId])
  @@map("draft_lineage")
}

// =============================================================================
// Customization
// =============================================================================

model Theme {
  id          String   @id @default(uuid())
  userId      String?  // Null for built-in themes
  name        String
  displayName String?
  description String?
  author      String?
  tags        String[]
  basedOn     String?
  isBuiltin   Boolean  @default(false)
  colors      Json     // ThemeColors interface
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([name]) // Theme names must be unique globally (built-ins + user themes)
  @@map("themes")
}

model Template {
  id               String   @id @default(uuid())
  userId           String?  // Null for official templates
  name             String
  version          String
  description      String?
  isOfficial       Boolean  @default(false)
  isDefault        Boolean  @default(false)
  assets           Json     // AssetDefinition[]
  blueprintContent Json     @default("{}") // Record<string, string>
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([name]) // Template names must be unique globally
  @@map("templates")
}

model SavedSeed {
  id         String   @id @default(uuid())
  userId     String
  seed       String
  addedAt    DateTime
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seed])
  @@index([userId])
  @@index([addedAt(sort: Desc)])
  @@map("saved_seeds")
}

// =============================================================================
// User Configuration
// =============================================================================

model UserConfig {
  id                 String   @id @default(uuid())
  userId             String   @unique
  config             Json     @default("{}") // Config without api_keys
  encryptedApiKeys   Bytes?   // AES-256-GCM encrypted
  apiKeysNonce       Bytes?   // Encryption nonce
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_config")
}

// =============================================================================
// Blueprints
// =============================================================================

model Blueprint {
  id          String   @id @default(uuid())
  userId      String?  // Null for built-in blueprints
  path        String   @unique // e.g., "blueprints/custom/my_blueprint.md"
  name        String
  description String?
  invokable   Boolean  @default(true)
  version     String   @default("1.0")
  category    String   @default("core") // 'core', 'system', 'template', 'example', 'custom'
  content     String   // Full markdown content with frontmatter
  isBuiltin   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@map("blueprints")
}

// =============================================================================
// Worlds (Story/Setting Containers)
// =============================================================================

model World {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  genre       String?
  setting     String?  // Time period, location, etc.
  notes       String?  // Free-form worldbuilding notes
  tags        String[]
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  timelines Timeline[]
  characters WorldCharacter[]

  @@unique([userId, name])
  @@index([userId])
  @@map("worlds")
}

model WorldCharacter {
  id           String   @id @default(uuid())
  worldId      String
  draftId      String?  // Link to character draft
  characterName String
  role         String?  // Protagonist, antagonist, supporting, etc.
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([worldId, characterName])
  @@index([worldId])
  @@map("world_characters")
}

// =============================================================================
// Timelines
// =============================================================================

model Timeline {
  id          String   @id @default(uuid())
  worldId     String
  userId      String
  name        String
  description String?
  startDate   String?  // In-world start date (freeform string)
  endDate     String?  // In-world end date
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  world  World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events TimelineEvent[]

  @@unique([worldId, name])
  @@index([worldId])
  @@index([userId])
  @@map("timelines")
}

model TimelineEvent {
  id          String   @id @default(uuid())
  timelineId  String
  title       String
  description String?
  eventDate   String?  // In-world date (freeform string)
  sortOrder   Int      @default(0)
  tags        String[]
  metadata    Json     @default("{}") // Custom event data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  timeline Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  @@index([timelineId])
  @@map("timeline_events")
}
