{
  "name": "@char-gen/mobile",
  "version": "4.4.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "generate:content": "node ../../tools/generation/generate-mobile-local-content.mjs",
    "prepare:android:release": "pnpm run generate:content && pnpm --filter @char-gen/shared build",
    "build:apk": "powershell -ExecutionPolicy Bypass -File ../../tools/mobile/build-android-apk.ps1",
    "prestart": "pnpm run generate:content && pnpm --filter @char-gen/shared build",
    "start": "expo start --clear",
    "preandroid": "pnpm run generate:content && pnpm --filter @char-gen/shared build",
    "android": "expo run:android",
    "preios": "pnpm run generate:content && pnpm --filter @char-gen/shared build",
    "ios": "expo run:ios",
    "pretypecheck": "pnpm run generate:content && pnpm --filter @char-gen/shared build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pretest": "pnpm --filter @char-gen/shared build",
    "test": "vitest run",
    "lint": "eslint src App.tsx --ext .ts,.tsx"
  },
  "dependencies": {
    "@char-gen/shared": "workspace:*",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.25",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~54.0.37",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "metro-runtime": "^0.87.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native-community/cli": "^20.2.0",
    "@types/react": "^19.1.17",
    "babel-preset-expo": "^54.0.12",
    "eslint": "^9.16.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
