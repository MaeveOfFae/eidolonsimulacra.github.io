{
  "expo": {
    "name": "Eidolon Simulacra",
    "slug": "eidolon-simulacra",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "eidolon-simulacra",
    "platforms": ["ios", "android"],
    "android": {
      "package": "io.github.maeveoffae.eidolonsimulacra",
      "versionCode": 1,
      "usesCleartextTraffic": true
    },
    "jsEngine": "hermes",
    "plugins": [
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Eidolon Simulacra to scan a desktop pairing QR code."
        }
      ]
    ]
  }
}
