{
  "expo": {
    "name": "Eidolon Simulacra",
    "slug": "eidolon-simulacra",
    "version": "5.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0f"
    },
    "scheme": "eidolon-simulacra",
    "platforms": ["ios", "android"],
    "android": {
      "package": "io.github.maeveoffae.eidolonsimulacra",
      "versionCode": 11,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f0f"
      }
    },
    "jsEngine": "hermes",
    "plugins": [
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Eidolon Simulacra to scan a desktop pairing QR code."
        }
      ]
    ]
  }
}
