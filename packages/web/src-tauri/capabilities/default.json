{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-shell",
  "description": "Enables the main window to use core IPC and native save dialogs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive",
    "sql:default",
    "sql:allow-execute"
  ]
}