# Caddyfile for Eidolon Character Generator
# Override the domain with EIDOLON_DOMAIN in your Compose env file if needed.

{$EIDOLON_DOMAIN:api.eidolonsimulacra.com} {
    reverse_proxy eidolon:3001

    # Enable gzip compression
    encode gzip zstd

    # Security headers
    header {
        # Enable HSTS
        Strict-Transport-Security "max-age=31536000; include-subdomains; preload"

        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"

        # Prevent MIME sniffing
        X-Content-Type-Options "nosniff"

        # XSS protection
        X-XSS-Protection "1; mode=block"

        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"

        # Remove server header
        -Server
    }

    # Log to stdout so Docker Desktop can collect logs directly.
    log {
        output stdout
        format console
    }
}

# Development configuration (optional)
# Uncomment for local development with HTTPS
# localhost {
#     tls internal
#
#     reverse_proxy eidolon:3001
# }
