# Docker runtime env for the combined Eidolon container and Caddy.
# Copy to .env before running docker compose --env-file .env up -d.

# Required
DB_PASSWORD=change-me-now
JWT_SECRET=replace-with-64-hex-characters
JWT_REFRESH_SECRET=replace-with-64-hex-characters
ENCRYPTION_KEY=replace-with-64-hex-characters

# Required for browser app origin allowed by CORS
CORS_ORIGIN=https://eidolonsimulacra.com
EIDOLON_DOMAIN=api.eidolonsimulacra.com
TRUST_PROXY=1

# Optional API rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_AUTH_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_AUTH_MAX=40

# Optional OAuth redirects
# If you host API on api.eidolonsimulacra.com and web on eidolonsimulacra.com:
OAUTH_REDIRECT_BASE=https://api.eidolonsimulacra.com
FRONTEND_URL=https://eidolonsimulacra.com

# Optional OAuth provider credentials
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
