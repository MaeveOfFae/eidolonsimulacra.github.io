export default "[template]\r\nname = \"Side Characters\"\r\nversion = \"1.0\"\r\ndescription = \"Lightweight supporting-cast NPC template: a compact profile, an in-scene voice, and a ready-to-play scene hook.\"\r\n\r\n[[assets]]\r\nname = \"npc_profile\"\r\nrequired = true\r\ndepends_on = []\r\ndescription = \"Compact NPC identity, role, and pressure\"\r\nblueprint_file = \"blueprints/templates/side_characters/assets/npc_profile.md\"\r\n\r\n[[assets]]\r\nname = \"npc_voice\"\r\nrequired = true\r\ndepends_on = [\r\n    \"npc_profile\",\r\n]\r\ndescription = \"Speech, mannerisms, and behavioural tells\"\r\nblueprint_file = \"blueprints/templates/side_characters/assets/npc_voice.md\"\r\n\r\n[[assets]]\r\nname = \"npc_scene_hook\"\r\nrequired = true\r\ndepends_on = [\r\n    \"npc_profile\",\r\n    \"npc_voice\",\r\n]\r\ndescription = \"Short in-scene situation, stakes, and open loop\"\r\nblueprint_file = \"blueprints/templates/side_characters/assets/npc_scene_hook.md\"\r\n\r\n[[assets]]\r\nname = \"a1111\"\r\nrequired = false\r\ndepends_on = [\r\n    \"npc_profile\",\r\n]\r\ndescription = \"Stable Diffusion image generation prompt\"\r\nblueprint_file = \"blueprints/system/a1111.md\"\r\n"