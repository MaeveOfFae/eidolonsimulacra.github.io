export default "[template]\r\nname = \"GURPS 4e\"\r\nversion = \"1.0\"\r\ndescription = \"GURPS 4th Edition character template: concept sheet, rules-valid point build, backstory, and an in-fiction opening scene.\"\r\n\r\n[[assets]]\r\nname = \"gurps_character_sheet\"\r\nrequired = true\r\ndepends_on = []\r\ndescription = \"Character concept, tech level, and personality\"\r\nblueprint_file = \"blueprints/templates/gurps/assets/gurps_character_sheet.md\"\r\n\r\n[[assets]]\r\nname = \"gurps_stat_block\"\r\nrequired = true\r\ndepends_on = [\r\n    \"gurps_character_sheet\",\r\n]\r\ndescription = \"Rules-valid point build (attributes, traits, skills, damage)\"\r\nblueprint_file = \"blueprints/templates/gurps/assets/gurps_stat_block.md\"\r\n\r\n[[assets]]\r\nname = \"gurps_backstory\"\r\nrequired = true\r\ndepends_on = [\r\n    \"gurps_character_sheet\",\r\n]\r\ndescription = \"Backstory, ties, and playable hooks\"\r\nblueprint_file = \"blueprints/templates/gurps/assets/gurps_backstory.md\"\r\n\r\n[[assets]]\r\nname = \"gurps_intro_scene\"\r\nrequired = true\r\ndepends_on = [\r\n    \"gurps_character_sheet\",\r\n    \"gurps_stat_block\",\r\n    \"gurps_backstory\",\r\n]\r\ndescription = \"In-fiction opening scene\"\r\nblueprint_file = \"blueprints/templates/gurps/assets/gurps_intro_scene.md\"\r\n\r\n[[assets]]\r\nname = \"a1111\"\r\nrequired = false\r\ndepends_on = [\r\n    \"gurps_character_sheet\",\r\n]\r\ndescription = \"Stable Diffusion image generation prompt\"\r\nblueprint_file = \"blueprints/system/a1111.md\"\r\n"