export default "[template]\r\nname = \"Pathfinder 1e\"\r\nversion = \"1.0\"\r\ndescription = \"Pathfinder First Edition character template: identity sheet, rules-valid stat block, backstory, and an in-fiction opening scene.\"\r\n\r\n[[assets]]\r\nname = \"pf_character_sheet\"\r\nrequired = true\r\ndepends_on = []\r\ndescription = \"Character identity, alignment, and appearance\"\r\nblueprint_file = \"blueprints/templates/pathfinder1e/assets/pf_character_sheet.md\"\r\n\r\n[[assets]]\r\nname = \"pf_stat_block\"\r\nrequired = true\r\ndepends_on = [\r\n    \"pf_character_sheet\",\r\n]\r\ndescription = \"Rules-valid First Edition stat block (BAB, CMB/CMD, saves, spells)\"\r\nblueprint_file = \"blueprints/templates/pathfinder1e/assets/pf_stat_block.md\"\r\n\r\n[[assets]]\r\nname = \"pf_backstory\"\r\nrequired = true\r\ndepends_on = [\r\n    \"pf_character_sheet\",\r\n]\r\ndescription = \"Backstory, ties, and playable story hooks\"\r\nblueprint_file = \"blueprints/templates/pathfinder1e/assets/pf_backstory.md\"\r\n\r\n[[assets]]\r\nname = \"pf_intro_scene\"\r\nrequired = true\r\ndepends_on = [\r\n    \"pf_character_sheet\",\r\n    \"pf_stat_block\",\r\n    \"pf_backstory\",\r\n]\r\ndescription = \"In-fiction opening scene\"\r\nblueprint_file = \"blueprints/templates/pathfinder1e/assets/pf_intro_scene.md\"\r\n\r\n[[assets]]\r\nname = \"a1111\"\r\nrequired = false\r\ndepends_on = [\r\n    \"pf_character_sheet\",\r\n]\r\ndescription = \"Stable Diffusion image generation prompt\"\r\nblueprint_file = \"blueprints/system/a1111.md\"\r\n"